[Unit]
Description=Firewall do oute-surreal-db (regras DOCKER-USER)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Ajuste o caminho para onde o repositório está no servidor.
ExecStart=/opt/oute-surreal-db/scripts/firewall_surreal.sh
ExecStop=/opt/oute-surreal-db/scripts/firewall_surreal.sh --remove

[Install]
WantedBy=multi-user.target
