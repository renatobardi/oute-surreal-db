# Copie para .env (chmod 600, ignorado pelo git) e preencha. Segredos reais ficam no cofre, nunca aqui.
# Roda DENTRO do LXC oute-surreal-db (Docker próprio). Nada aqui toca o host.

# Imagem fixada por digest (= v3.3.0 multi-arch). Upgrade é deliberado.
SURREAL_IMAGE=surrealdb/surrealdb:v3.3.0@sha256:681c6c22c287421b5c7d99e0fde79b6e0d32c36c1ddeaab2762a1661cb04cd20
SURREAL_CONTAINER_NAME=oute-surreal-db
SURREAL_ROOT_USER=root
SURREAL_ROOT_PASS=

# Porta publicada no LXC; só a rede LXD (lxdbr0) alcança o LXC.
SURREAL_PORT=8000

# Diretório de dados no LXC (precisa ser 10001:10001).
SURREAL_DATA_DIR=/srv/oute-surreal-db/data

# Limites: sem mem_limit o cache do RocksDB mede pela RAM do host (~metade).
SURREAL_MEM_LIMIT=2g
SURREAL_CPUS=1

# Projetos e ambientes existentes: projeto:db1,db2 ... Só o que existe (obo não tem test).
# Hífen no projeto vira underscore no namespace.
SURREAL_PROJECTS="kubo:prd,test obo:prd"
