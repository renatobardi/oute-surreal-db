# Copie para .env (chmod 600, ignorado pelo git) e preencha. Segredos reais ficam no cofre, nunca aqui.
# Imagem fixada por digest (= v3.3.0 multi-arch). Upgrade é deliberado.
SURREAL_IMAGE=surrealdb/surrealdb:v3.3.0@sha256:681c6c22c287421b5c7d99e0fde79b6e0d32c36c1ddeaab2762a1661cb04cd20
SURREAL_CONTAINER_NAME=oute-surreal-db
SURREAL_ROOT_USER=root
SURREAL_ROOT_PASS=

# Publicado somente na bridge LXD (lxdbr0). O firewall (scripts/firewall_surreal.sh) restringe a origem.
SURREAL_BIND_IP=10.173.117.1
SURREAL_PORT=8000
SURREAL_ALLOWED_CIDR=10.173.117.0/24

# Diretório de dados PRÓPRIO desta instância (disco /mnt/lxd). Nunca aponte para o dir do oute-agent.
SURREAL_DATA_DIR=/mnt/lxd/oute-surreal-db

# Limites: sem mem_limit o cache do RocksDB mede pela RAM do host (~metade).
SURREAL_MEM_LIMIT=2g
SURREAL_CPUS=1

# Projetos (um namespace por projeto, databases dev e prod). Hífen vira underscore no namespace.
SURREAL_PROJECTS="obo kubo oute-agent hanko frentes-engenharia financial-control vaultgarden"
